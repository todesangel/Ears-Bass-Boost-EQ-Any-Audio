{
  "manifest_version": 3,
  "name": "Ears: Bass Boost, EQ Any Audio!",
  "short_name": "Ears",
  "description": "EQ any audio you find on the web, live! Crank the bass, dim the highs, up the vocals: all with Ears!",
  "version": "1.3.12",
  "author": "Kevin King",
  "browser_specific_settings": {
    "gecko": {
      "id": "ears-audio-toolkit@qupad.github.io",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "ears16.png",
    "32": "ears32.png",
    "48": "ears48.png",
    "64": "ears64.png",
    "128": "ears128.png"
  },
  "action": {
    "default_icon": "ears128.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
